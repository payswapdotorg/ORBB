{
  "name": "@orbb/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ORBB design-token system (typography, spacing, semantic colors with contract-checked contrast pairs, elevation, motion, radii, touch targets) plus a minimal set of accessible React primitives. Tokens are framework-neutral; components are web-oriented. Source-published so web (Next.js transpilePackages) and mobile (Metro) consume one token source of truth.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens": {
      "types": "./src/tokens.ts",
      "default": "./src/tokens.ts"
    },
    "./css": {
      "types": "./src/css.ts",
      "default": "./src/css.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.30.0",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.0",
    "vitest": "^3.2.4"
  }
}
