# ORBB environment template (owned by @orbb/config).
# Copy to your app's .env and fill in real values. Never commit real
# secrets — parseEnvironment() diagnostics contain variable NAMES only.

# Required
NODE_ENV=development
LOG_LEVEL=info

# Optional — relational database (required when NODE_ENV=production)
# DATABASE_URL=postgres://user:password@localhost:5432/orbb

# Optional — S3-compatible object store for evidence payloads
# OBJECT_STORE_ENDPOINT=https://s3.example.internal
# OBJECT_STORE_BUCKET=orbb-evidence
# OBJECT_STORE_REGION=us-east-1
# OBJECT_STORE_ACCESS_KEY_ID=replace-me
# OBJECT_STORE_SECRET_ACCESS_KEY=replace-me

# Optional — cache (coordination state only; never a source of truth)
# CACHE_URL=redis://localhost:6379/0
# CACHE_TTL_SECONDS=300

# Optional — HTTP API port
# API_PORT=3000
